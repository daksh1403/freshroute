{
  "name": "freshroute",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/runtime/*"
    ]
  },
  "vars": {
    "GEMMA_MODEL": "gemma-4-26b-a4b-it"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "placement": {
    "region": "aws:ap-south-1"
  }
}
